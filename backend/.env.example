PORT=4000
DATABASE_URL=postgresql://ats:ats@localhost:5433/ats
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Object storage (SeaweedFS S3 locally; any S3-compatible in prod)
S3_ENDPOINT=http://localhost:8333
# Host the browser uses for signed resume links (differs when the API runs inside Docker)
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=resumes
S3_ACCESS_KEY=local-dev-key
S3_SECRET_KEY=local-dev-secret

# Email sandbox (Mailpit UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="Talent Team <no-reply@ats.local>"
